---
let googleBadge = null;

try {
  const reviewsModule = await import("../data/google-reviews.json");
  const reviewsData = reviewsModule?.default ?? reviewsModule;
  const rating = Number(reviewsData?.rating);
  const totalReviews = Number(reviewsData?.totalReviews);
  const googleUrl = reviewsData?.googleUrl;

  if (!Number.isNaN(rating) && !Number.isNaN(totalReviews) && googleUrl) {
    googleBadge = {
      rating: rating.toFixed(1),
      totalReviews,
      googleUrl,
    };
  }
} catch {
  googleBadge = null;
}

const slides = [
  {
    eyebrow: "Brain Restore in Florence SC",
    title: "Advanced Brain & Nervous System Recovery",
    body:
      "A calmer, more objective path for patients looking beyond generic wellness care, with neurological evaluation, Brain Restore programs, and recovery-focused therapies.",
    image: "/images/neuro/brain-imaging-pexels-cottonbro.jpg",
    backgroundPosition: "center",
    ctas: [
      { label: "Schedule Evaluation", href: "/contact-us/" },
      { label: "Learn About Brain Restore", href: "/brain-restore/" }
    ]
  },
  {
    eyebrow: "Hyperbaric Oxygen Therapy",
    title: "Recovery Support With Pressurized Oxygen",
    body:
      "HBOT is being integrated as part of a broader, evidence-aware recovery strategy focused on oxygen delivery, safety, screening, and individualized care.",
    image: "/images/neuro/hyperbaric-chamber-unsplash-navy-medicine.jpg",
    backgroundPosition: "center",
    ctas: [
      { label: "Explore HBOT", href: "/services/hbot/" },
      { label: "Start Your Recovery Journey", href: "/contact-us/" }
    ]
  },
  {
    eyebrow: "Chiropractic + Neurological Wellness",
    title: "Care That Looks at the Whole Nervous System",
    body:
      "Integrative Health Solutions still provides trusted chiropractic care, now framed within a more advanced model for brain health, movement, and long-term resilience.",
    image: "/images/neuro/advanced-evaluation-pexels-charlss-gonzhu.jpg",
    backgroundPosition: "center",
    ctas: [
      { label: "View Services", href: "/services/" },
      { label: "Request Appointment", href: "/contact-us/" }
    ]
  },
];
---
<section class="hero-carousel" aria-label="Brain Restore and neurological recovery highlights">
  <div class="hero-carousel__track">
    {slides.map((slide, index) => (
      <article
        class={`hero-carousel__slide ${index === 0 ? "is-active" : ""}`}
        style={`--hero-position: ${slide.backgroundPosition ?? "center"};`}
        aria-hidden={index === 0 ? "false" : "true"}
      >
        <img
          class="hero-carousel__image"
          src={slide.image}
          alt={`${slide.title} at Integrative Health Solutions in Florence SC`}
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          decoding="async"
        />
        <div class="hero-carousel__overlay"></div>
        <div class="hero-carousel__content container">
          <p class="hero-carousel__eyebrow">{slide.eyebrow}</p>
          <h1>{slide.title}</h1>
          <p class="hero-carousel__body">{slide.body}</p>
          <div class="hero-carousel__actions" aria-label={`${slide.title} actions`}>
            {slide.ctas.map((cta, ctaIndex) => (
              <a class={`btn ${ctaIndex === 0 ? "btn-primary" : "btn-ghost"}`} href={cta.href}>
                {cta.label}
              </a>
            ))}
          </div>
          {googleBadge && (
            <a
              class="hero-rating-badge"
              href={googleBadge.googleUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {`\u2605 ${googleBadge.rating} on Google \u2022 ${googleBadge.totalReviews} reviews`}
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    const carousels = document.querySelectorAll(".hero-carousel");

    carousels.forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll(".hero-carousel__slide"));
      if (slides.length < 2) return;

      let currentIndex = 0;
      let intervalId;

      const setActiveSlide = (nextIndex) => {
        currentIndex = (nextIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === currentIndex;
          slide.classList.toggle("is-active", isActive);
          slide.setAttribute("aria-hidden", isActive ? "false" : "true");
          slide.querySelectorAll("a, button").forEach((element) => {
            if (isActive) {
              element.removeAttribute("tabindex");
            } else {
              element.setAttribute("tabindex", "-1");
            }
          });
        });
      };

      const stopRotation = () => {
        if (intervalId) {
          window.clearInterval(intervalId);
          intervalId = undefined;
        }
      };

      const startRotation = () => {
        stopRotation();
        intervalId = window.setInterval(() => {
          setActiveSlide(currentIndex + 1);
        }, 6000);
      };

      carousel.addEventListener("mouseenter", stopRotation);
      carousel.addEventListener("mouseleave", startRotation);

      setActiveSlide(0);
      startRotation();
    });
  })();

  (() => {
    if (window.__ihsRevealObserverInitialized) return;
    window.__ihsRevealObserverInitialized = true;

    const initReveals = () => {
      const sections = Array.from(document.querySelectorAll(".section"));

      sections.forEach((section) => {
        const cards = Array.from(section.querySelectorAll(".card"));
        cards.forEach((card, index) => {
          if (!card.hasAttribute("data-reveal-delay")) {
            card.setAttribute("data-reveal-delay", `${Math.min(index * 90, 360)}ms`);
          }
        });

        const reviewCards = Array.from(section.querySelectorAll(".review-card"));
        reviewCards.forEach((card, index) => {
          card.setAttribute("data-reveal-delay", `${Math.min(index * 90, 360)}ms`);
        });
      });

      const targets = Array.from(document.querySelectorAll(".section, .card, .review-card"));
      if (targets.length === 0) return;

      targets.forEach((element) => {
        element.classList.add("reveal");

        const rawDelay = (element.getAttribute("data-reveal-delay") || "").trim();
        if (rawDelay.length === 0) return;

        const normalizedDelay = /ms$|s$/i.test(rawDelay) ? rawDelay : `${rawDelay}ms`;
        element.style.transitionDelay = normalizedDelay;
      });

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReducedMotion || !("IntersectionObserver" in window)) {
        targets.forEach((element) => element.classList.add("is-visible"));
        return;
      }

      const observer = new IntersectionObserver(
        (entries, activeObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            activeObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.15,
          rootMargin: "0px 0px -30px 0px",
        },
      );

      targets.forEach((element) => observer.observe(element));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initReveals, { once: true });
    } else {
      initReveals();
    }
  })();
</script>
