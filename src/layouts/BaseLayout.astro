---
import { branding } from "../config/branding";
import { siteConfig } from "../config/site";
import "../styles/global.css";

const {
  title = "Brain Restore and Chiropractic Care in Florence SC",
  description,
  canonicalPath,
  robots = "index, follow"
} = Astro.props;
const metaDescription =
  description ??
  "Integrative Health Solutions provides Brain Restore programs, hyperbaric oxygen therapy guidance, neurological wellness support, and chiropractic care in Florence, SC.";
const fullTitle = title.includes(branding.clinicName)
  ? title
  : `${title} | ${branding.clinicName}`;
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, siteConfig.siteUrl).toString()
  : undefined;
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: branding.clinicName,
  alternateName: [
    "Best Florence Chiropractor",
    "Best Florence Chiro",
    "Your Florence Chiro",
    "Your Florence Chiros"
  ],
  url: siteConfig.siteUrl,
  sameAs: siteConfig.domainAliases,
  telephone: siteConfig.phone,
  email: siteConfig.email,
  medicalSpecialty: [
    "Chiropractic",
    "Neurological Wellness",
    "Hyperbaric Oxygen Therapy"
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.city,
    addressRegion: siteConfig.address.state,
    postalCode: siteConfig.address.zip,
    addressCountry: "US"
  },
  areaServed: {
    "@type": "City",
    name: "Florence"
  }
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: branding.clinicName,
  alternateName: [
    "Best Florence Chiropractor",
    "Best Florence Chiro",
    "Your Florence Chiro",
    "Your Florence Chiros"
  ],
  url: siteConfig.siteUrl,
  sameAs: siteConfig.domainAliases
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={metaDescription} />
  <meta name="robots" content={robots} />
  <title>{fullTitle}</title>
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <meta property="og:site_name" content={branding.clinicName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <slot name="head" />
  <link rel="icon" type="image/png" href={branding.favicon} sizes="32x32" />
  <link rel="shortcut icon" href={branding.favicon} />
  <script is:inline>window.ORDINIS_SITE_ID = "ihs";</script>
  <script async src="/scripts/tracking-snippet.js"></script>
</head>
<body>
  <slot />
  <script is:inline>
    (() => {
      const withAnalytics = (callback, attempts = 20) => {
        if (window.ordinisAnalytics?.track) {
          callback(window.ordinisAnalytics);
          return;
        }

        if (attempts <= 0) return;
        window.setTimeout(() => withAnalytics(callback, attempts - 1), 150);
      };

      const formLabel = (element) =>
        element?.getAttribute("data-ordinis-value") ||
        element?.getAttribute("data-ordinis-form") ||
        "form";

      const markFormStart = (element) => {
        if (!element || element.dataset.ordinisStarted === "true") return;
        element.dataset.ordinisStarted = "true";
        withAnalytics((analytics) => {
          analytics.track("form_start", {
            event_value: formLabel(element),
            form_id: element.getAttribute("data-form-id"),
          });
        });
      };

      const initEmbeddedForms = () => {
        document.querySelectorAll("[data-ordinis-form]").forEach((element) => {
          element.addEventListener("pointerdown", () => markFormStart(element), {
            once: true,
            capture: true,
          });
        });
      };

      window.addEventListener("message", (event) => {
        const raw = event.data;
        const message =
          typeof raw === "string" ? raw : raw && typeof raw === "object" ? JSON.stringify(raw) : "";
        if (!/jotform|submission/i.test(message)) return;

        const contactForm = document.querySelector('[data-ordinis-form="contact"]');
        if (!contactForm) return;

        const detail = {
          form: formLabel(contactForm),
          form_id: contactForm.getAttribute("data-form-id"),
          provider: "jotform",
        };

        if (/submission-completed|submit|thank/i.test(message)) {
          withAnalytics((analytics) => {
            analytics.track("contact_form_submit", {
              event_value: detail.form,
              form_id: detail.form_id,
              provider: detail.provider,
            });
          });
          window.dispatchEvent(new CustomEvent("ordinis:form-success", { detail }));
        } else if (/error|fail|invalid/i.test(message)) {
          window.dispatchEvent(new CustomEvent("ordinis:form-failure", { detail }));
        }
      });

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initEmbeddedForms, { once: true });
      } else {
        initEmbeddedForms();
      }
    })();
  </script>
</body>
</html>
