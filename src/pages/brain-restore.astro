---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LocalServiceArea from "../components/LocalServiceArea.astro";
---

<BaseLayout
  title="Brain Restore in Florence SC"
  description="Brain Restore at Integrative Health Solutions in Florence, SC combines neurological wellness evaluation, brain health support, HBOT guidance, and chiropractic care with conservative recovery planning."
  canonicalPath="/brain-restore/"
>
  <Header />

  <main>
    <section class="restore-hero">
      <div class="container restore-hero-grid">
        <div>
          <p class="restore-label">Brain Restore</p>
          <h1>Advanced Brain & Nervous System Recovery</h1>
          <p class="restore-lede">
            Brain Restore is our flagship care direction for patients who want a deeper,
            more objective approach to neurological wellness, cognitive resilience,
            nerve-related symptoms, and recovery after stress or injury.
          </p>
          <div class="restore-actions">
            <a class="btn btn-primary" href="/contact-us/">Schedule Evaluation</a>
            <a class="btn btn-ghost" href="/services/hbot/">Explore HBOT</a>
          </div>
        </div>
        <aside class="restore-card" aria-label="Brain Restore focus areas">
          <span>Clinical Focus</span>
          <ul>
            <li>Neurological wellness evaluation</li>
            <li>Brain health and neuroplasticity support</li>
            <li>HBOT readiness and safety screening</li>
            <li>Chiropractic care with a nervous system lens</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="section restore-intro">
      <div class="container split-grid">
        <div>
          <p class="section-label">Why Brain Restore</p>
          <h2>When symptoms need more than a generic plan</h2>
        </div>
        <div>
          <p>
            Many patients arrive after trying approaches that only address one part of the
            problem. Brain Restore looks at how the brain, spine, nerves, metabolism, sleep,
            stress load, movement, and recovery capacity may be interacting.
          </p>
          <p>
            The goal is not to promise a cure. The goal is to build a clearer clinical
            picture, support healthier nervous system function, and choose therapies that
            match the patient's needs and safety profile.
          </p>
        </div>
      </div>
    </section>

    <section class="section philosophy-section">
      <div class="container split-grid">
        <div>
          <p class="section-label">Clinical Philosophy</p>
          <h2>Led by systems-based neurological thinking</h2>
          <p>
            Dr. Kristin Hieshetter's Brain Restore philosophy starts with a simple
            premise: functional neurological symptoms deserve to be understood, not
            dismissed. Patients often know something feels off long before a single
            diagnosis explains the full picture.
          </p>
        </div>
        <div class="quote-panel">
          <p>
            Brain Restore is built for the patient who has been told to wait, cope,
            or accept a smaller life, but still feels there may be a deeper recovery
            pathway worth exploring.
          </p>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <p class="section-label">Patient Journey</p>
        <h2>A measured path from evaluation to recovery support</h2>
        <div class="process-grid">
          <article>
            <span>01</span>
            <h3>Listen and Evaluate</h3>
            <p>
              We begin with your history, symptoms, goals, and a clinical evaluation that
              may include neurological, movement, and lifestyle considerations.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>Map the Care Strategy</h3>
            <p>
              Your plan may combine chiropractic care, brain health strategies, nutrition,
              laser therapy, rehabilitation, or HBOT discussion when appropriate.
            </p>
          </article>
          <article>
            <span>03</span>
            <h3>Monitor and Adjust</h3>
            <p>
              Progress is reviewed over time so care can be refined around function,
              tolerance, response, and realistic next steps.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section framework-section">
      <div class="container">
        <p class="section-label">The Framework</p>
        <h2>Six pillars of Brain Restore</h2>
        <div class="framework-grid">
          <article>
            <span>01</span>
            <h3>Neurological Evaluation</h3>
            <p>Listening, examination, and functional pattern recognition before treatment selection.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Oxygenation</h3>
            <p>Thoughtful discussion of oxygen delivery, HBOT readiness, screening, and recovery context.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Neuroplasticity</h3>
            <p>Support for the brain's ability to adapt through appropriate stimulus, pacing, and repetition.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Metabolic Support</h3>
            <p>Nutrition, inflammation load, sleep, and energy systems considered as part of recovery capacity.</p>
          </article>
          <article>
            <span>05</span>
            <h3>Regulation</h3>
            <p>Support for autonomic balance, stress tolerance, sensory load, and recovery rhythm.</p>
          </article>
          <article>
            <span>06</span>
            <h3>Cognitive Recovery</h3>
            <p>Care plans that respect focus, memory, screen tolerance, fatigue, and daily function.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section hbot-feature">
      <div class="container split-grid">
        <div>
          <p class="section-label">HBOT + Recovery</p>
          <h2>Hyperbaric oxygen therapy, framed responsibly</h2>
          <p>
            HBOT uses pressurized oxygen to increase oxygen delivery in controlled clinical
            settings. It has established medical uses for selected indications and is also
            being studied for additional neurological and recovery-oriented applications.
          </p>
        </div>
        <div class="feature-panel">
          <p>
            For Brain Restore, HBOT should be understood as one potential part of a broader
            care strategy. Patients need screening, safety guidance, and expectation-setting
            before deciding whether it belongs in their plan.
          </p>
          <a class="btn btn-primary" href="/services/hbot/">Learn About HBOT</a>
        </div>
      </div>
    </section>

    <section class="section education-section">
      <div class="container split-grid">
        <div>
          <p class="section-label">Why Symptoms Persist</p>
          <h2>Normal tests do not always explain functional dysfunction</h2>
        </div>
        <div>
          <p>
            Imaging and labs can be essential, especially when ruling out serious
            disease. But many patients with brain fog, dizziness, headaches, cognitive
            fatigue, or overload are dealing with functional changes in tolerance,
            regulation, recovery, and system coordination.
          </p>
          <p>
            Brain Restore works in that space carefully. We do not replace medical
            diagnosis. We help patients organize the next layer of the recovery
            conversation when the nervous system still feels disrupted.
          </p>
        </div>
      </div>
    </section>

    <section class="section restore-links">
      <div class="container">
        <p class="section-label">Related Care</p>
        <h2>Explore supportive services</h2>
        <div class="link-grid">
          <a href="/services/brain-health/">Brain Health Programs</a>
          <a href="/services/hbot/">Hyperbaric Oxygen Therapy</a>
          <a href="/services/chiropractic/">Chiropractic Care</a>
          <a href="/services/neuropathy/">Peripheral Neuropathy Care</a>
          <a href="/conditions/brain-fog/">Brain Fog Support</a>
          <a href="/conditions/post-concussion-symptoms/">Post-Concussion Support</a>
          <a href="/conditions/cognitive-fatigue/">Cognitive Fatigue</a>
          <a href="/conditions/dizziness-balance-problems/">Dizziness & Balance</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <aside class="cta-banner restore-cta" aria-label="Schedule Brain Restore evaluation">
          <div class="cta-content">
            <h2>Start with a Brain Restore evaluation</h2>
            <p>
              If you are looking for a more complete approach to brain health, nervous
              system support, or recovery planning, our team can help you understand your
              options.
            </p>
            <a class="btn btn-primary" href="/contact-us/">Schedule Evaluation</a>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <LocalServiceArea />
  <Footer />
</BaseLayout>

<style>
  .restore-hero {
    padding: 92px 0 76px;
    background:
      radial-gradient(circle at 78% 18%, rgba(36, 180, 126, 0.24), transparent 30%),
      linear-gradient(110deg, rgba(8, 18, 34, 0.96) 0%, rgba(16, 32, 56, 0.9) 52%, rgba(20, 45, 78, 0.62) 100%),
      url("/images/neuro/medical-imaging-room-pexels-jo-mcnamara.jpg") center / cover;
    color: #ffffff;
  }

  .restore-hero-grid,
  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 42px;
    align-items: center;
  }

  .restore-label,
  .section-label {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    font-weight: 800;
    color: #9ae6c5;
  }

  .section-label {
    color: var(--accent-purple);
  }

  .restore-hero h1 {
    max-width: 780px;
    margin-bottom: 18px;
    color: #ffffff;
    font-size: clamp(2.7rem, 6vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .restore-lede {
    max-width: 720px;
    margin: 0 0 26px;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1.08rem, 1.8vw, 1.28rem);
    line-height: 1.72;
  }

  .restore-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .restore-card,
  .feature-panel,
  .quote-panel {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    padding: 26px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.18);
  }

  .restore-card span {
    display: block;
    margin-bottom: 16px;
    color: #ffffff;
    font-weight: 800;
  }

  .restore-card ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 12px;
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.6;
  }

  .restore-intro,
  .restore-links,
  .education-section {
    background: #ffffff;
  }

  .split-grid h2,
  .process-section h2,
  .restore-links h2,
  .framework-section h2 {
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .split-grid p,
  .process-grid p,
  .feature-panel p,
  .framework-grid p,
  .quote-panel p {
    color: #3f4a5f;
    font-size: 1.03rem;
    line-height: 1.75;
  }

  .process-section {
    background:
      radial-gradient(circle at 85% 15%, rgba(36, 180, 126, 0.12), transparent 32%),
      #f6f8fb;
  }

  .process-grid,
  .link-grid,
  .framework-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .process-grid article,
  .framework-grid article {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    background: #ffffff;
  }

  .process-grid span,
  .framework-grid span {
    display: block;
    margin-bottom: 14px;
    color: var(--accent-purple);
    font-weight: 800;
  }

  .philosophy-section {
    background:
      linear-gradient(135deg, rgba(13, 23, 38, 0.94), rgba(24, 47, 82, 0.9)),
      url("/images/neuro/advanced-evaluation-pexels-charlss-gonzhu.jpg") center / cover;
    color: #ffffff;
  }

  .philosophy-section h2,
  .philosophy-section p {
    color: #ffffff;
  }

  .quote-panel {
    background: rgba(255, 255, 255, 0.13);
    backdrop-filter: blur(8px);
  }

  .quote-panel p {
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.18rem;
  }

  .framework-section {
    background: #07111f;
    color: #ffffff;
  }

  .framework-section h2,
  .framework-grid h3 {
    color: #ffffff;
  }

  .framework-grid article {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.07);
    box-shadow: none;
  }

  .framework-grid p {
    color: rgba(255, 255, 255, 0.76);
  }

  .hbot-feature {
    background:
      radial-gradient(circle at 10% 10%, rgba(37, 99, 235, 0.14), transparent 34%),
      #eef6ff;
  }

  .feature-panel {
    border-color: #dbe7ff;
    background: #ffffff;
  }

  .link-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .link-grid a {
    display: block;
    padding: 18px;
    border: 1px solid #dbe7ff;
    border-radius: 12px;
    color: #10213a;
    font-weight: 800;
    background: #f8fbff;
  }

  .restore-cta {
    margin-top: 0;
  }

  @media (max-width: 960px) {
    .restore-hero-grid,
    .split-grid,
    .process-grid,
    .framework-grid,
    .link-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .restore-hero {
      padding: 72px 0 56px;
    }

    .restore-actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
