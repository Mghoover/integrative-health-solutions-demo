---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site";

const forms = [
  {
    title: "\uD83D\uDC64 New Patient Intake",
    description: "Complete your full intake paperwork before your first appointment.",
    href: "/intake/new-patient",
  },
  {
    title: "\uD83D\uDC76 Infant Intake",
    description: "Submit pediatric intake details for infant appointments.",
    href: "/intake/infant",
  },
  {
    title: "\uD83E\uDDFE United Healthcare Summary",
    description: "Provide insurance-specific intake information for United Healthcare.",
    href: "/intake/uhc",
  },
  {
    title: "\u26A1 VZ8 Consultation Intake",
    description: "Share your health history for VZ8 consultation planning.",
    href: "/intake/vz8",
  },
  {
    title: "\u2709 Quick Contact",
    description: "Send a quick message to our team for scheduling or general questions.",
    href: "/intake/contact",
  },
];
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${siteConfig.address.street}, ${siteConfig.address.city}, ${siteConfig.address.state} ${siteConfig.address.zip}`)}`;
---
<BaseLayout
  title="Contact Integrative Health Solutions in Florence SC"
  description="Contact Integrative Health Solutions in Florence, SC to schedule a Brain Restore, HBOT, neurological wellness, or chiropractic evaluation."
  canonicalPath="/contact-us/"
>
<Header />
<main class="container">
  <section class="section section-accent">
    <div class="card intake-hero">
      <h1>Start Your Visit</h1>
      <p class="muted">Schedule an evaluation or complete the appropriate intake form before your appointment.</p>
      <div class="contact-summary" aria-label="Clinic contact information">
        <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, "")}`}>{siteConfig.phone}</a>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <a href={directionsUrl} target="_blank" rel="noopener noreferrer">
          {siteConfig.address.street}, {siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}
        </a>
      </div>
    </div>

    <div class="intake-grid">
      {forms.map((form) => (
        <div class="card intake-card">
          <h2>{form.title}</h2>
          <p class="muted">{form.description}</p>
          <a
            class="btn btn-primary"
            href={form.href}
            data-ordinis-event={form.href === "/intake/contact" ? "cta_click" : "appointment_request"}
            data-ordinis-value={form.title}
          >
            Open Form
          </a>
        </div>
      ))}
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
