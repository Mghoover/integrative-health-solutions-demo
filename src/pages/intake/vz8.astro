---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config/site";

const formId = siteConfig.intakeForms.vz8.trim();
---
<BaseLayout title="VZ8 Consultation Intake" description="VZ8 consultation intake form for Integrative Health Solutions in Florence, SC." canonicalPath="/intake/vz8/" robots="noindex, nofollow">
<Header />
<main class="container">
  <section class="section">
    <div class="card">
      <h1>VZ8 Consultation Intake</h1>
      <p class="muted">Please complete this form before your appointment.</p>
      {formId ? (
        <div
          class="form-embed"
          data-form-id={formId}
          data-ordinis-form="appointment_request"
          data-ordinis-event="appointment_request"
          data-ordinis-value="vz8_intake"
        >
          <script is:inline>
            (() => {
              const root = document.currentScript?.parentElement;
              const id = root?.getAttribute("data-form-id");
              if (!id) return;
              const script = document.createElement("script");
              script.src = `https://form.jotform.com/jsform/${id}`;
              root.appendChild(script);
            })();
          </script>
        </div>
      ) : (
        <p class="muted">Form coming soon.</p>
      )}
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
