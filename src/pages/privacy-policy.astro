---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for Integrative Health Solutions in Florence, SC."
  canonicalPath="/privacy-policy/"
>
<Header />
<main class="container">
  <section class="section">
    <h1>Privacy Policy</h1>
    <div class="card">
      <p>
        Integrative Health Solutions respects your privacy. Information submitted through
        contact forms, intake forms, phone calls, or email may be used to respond to your
        request, coordinate scheduling, and support patient communication.
      </p>
      <p>
        Please do not submit urgent medical concerns through this website. If you are
        experiencing a medical emergency, call 911 or seek immediate medical care.
      </p>
      <p>
        Third-party services such as embedded forms, analytics, review links, and external
        patient portals may collect information according to their own policies.
      </p>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
